#include "DHT.h"

#define DHTTYPE DHT11

#define DHTPIN1 2
#define DHTPIN2 3
#define WATERPIN A0

DHT dht1(DHTPIN1, DHTTYPE);
DHT dht2(DHTPIN2, DHTTYPE);

void setup() {
  Serial.begin(9600);

  dht1.begin();
  dht2.begin();

  Serial.println("================================");
  Serial.println("Climate Monitor Starting");
  Serial.println("================================");
}

void loop() {

  // Read temperature and humidity sensors
  float temp1 = dht1.readTemperature();
  float hum1  = dht1.readHumidity();

  float temp2 = dht2.readTemperature();
  float hum2  = dht2.readHumidity();

  // Read water sensor
  int waterValue = analogRead(WATERPIN);

  // Check if either DHT sensor failed
  if (isnan(temp1) || isnan(hum1)) {
    Serial.println("Sensor 1 read failed!");
  }

  if (isnan(temp2) || isnan(hum2)) {
    Serial.println("Sensor 2 read failed!");
  }

  // Print sensor 1
  Serial.print("Sensor 1  Temp: ");
  Serial.print(temp1);
  Serial.print(" C   Humidity: ");
  Serial.print(hum1);
  Serial.println(" %");

  // Print sensor 2
  Serial.print("Sensor 2  Temp: ");
  Serial.print(temp2);
  Serial.print(" C   Humidity: ");
  Serial.print(hum2);
  Serial.println(" %");

  // Print water sensor
  Serial.print("Water Sensor Value: ");
  Serial.println(waterValue);

  // Simple leak indication
  if (waterValue > 300) {
    Serial.println("WARNING - WATER DETECTED");
  } else {
    Serial.println("No water detected");
  }

  Serial.println("--------------------------------");

  delay(2000);
}
