#include <DHT.h>

#define DHTPIN1 2
#define DHTPIN2 3
#define DHTTYPE DHT11

#define WATER_SENSOR A0

DHT dht1(DHTPIN1, DHTTYPE);
DHT dht2(DHTPIN2, DHTTYPE);

void setup() {
  Serial.begin(9600);

  dht1.begin();
  dht2.begin();

  Serial.println("Railway Cabinet Monitor");
}

void loop() {

  float tempCabinet = dht1.readTemperature();
  float humCabinet = dht1.readHumidity();

  float tempExternal = dht2.readTemperature();
  float humExternal = dht2.readHumidity();

  int waterLevel = analogRead(WATER_SENSOR);

  Serial.println("-------------------------");

  Serial.print("Cabinet Temp: ");
  Serial.print(tempCabinet);
  Serial.println(" C");

  Serial.print("Cabinet RH: ");
  Serial.print(humCabinet);
  Serial.println(" %");

  Serial.print("External Temp: ");
  Serial.print(tempExternal);
  Serial.println(" C");

  Serial.print("External RH: ");
  Serial.print(humExternal);
  Serial.println(" %");

  Serial.print("Water Sensor: ");
  Serial.println(waterLevel);

  delay(2000);
}
